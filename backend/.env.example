# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/iravath
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FREE_SHIPPING_THRESHOLD=1999
SHIPPING_FEE=99
COD_ADVANCE=200
COD_MAX_ORDER_VALUE=10000

# Admin panel (/admin.html) - CHANGE BOTH before deploying
ADMIN_EMAIL=admin@iravath.in
ADMIN_PASSWORD=iravath-admin
ADMIN_SECRET=change-me-to-a-long-random-string
# MEDIA_DIR=/var/data/iravath-media   # product photos; use a persistent disk (or S3) in production

# ---- URLs ----
STORE_URL=http://localhost:3000            # Next.js storefront (used in emails)
API_URL=http://localhost:8000              # this API (admin links in emails)
CORS_ORIGINS=["http://localhost:3000"]     # set to ["https://iravath.in"] in production
STOREFRONT_REVALIDATE_SECRET=              # same as REVALIDATE_SECRET in storefront/.env (instant page refresh after admin edits)

# ---- Customer accounts (email OTP) ----
CUSTOMER_SECRET=change-me-customer-token-secret   # long random string, different from ADMIN_SECRET

# ---- Email (SMTP). Empty SMTP_HOST = emails are printed to the server log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
MAIL_FROM=Iravath <orders@iravath.in>
ADMIN_NOTIFY_EMAIL=                        # gets a copy of every new order

# ---- WhatsApp Cloud API (Meta). Empty = logged only ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANG=en
WA_TPL_ORDER_CONFIRMED=order_confirmed
WA_TPL_ORDER_SHIPPED=order_shipped
WA_TPL_ORDER_DELIVERED=order_delivered

# ---- Shiprocket. Empty email = mock shipments (fake AWB) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_AUTO_CREATE=true
SHIPROCKET_AUTO_AWB=true
SHIPROCKET_WEBHOOK_TOKEN=
PACKAGE_WEIGHT_KG=0.4
