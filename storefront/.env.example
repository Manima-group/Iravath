# Public URL of the FastAPI backend (browser + image host)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this storefront (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: backend URL as seen from the Next.js server (e.g. internal Render URL). Defaults to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
# Shared secret the backend uses to refresh pages instantly after admin edits (same value as STOREFRONT_REVALIDATE_SECRET in backend/.env)
REVALIDATE_SECRET=change-me-revalidate-secret
